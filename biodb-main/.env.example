# Generate the two application keys with, for example:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=replace-with-a-random-value
APP_JWT_SECRET_KEY=replace-with-a-random-value

# This OAuth client ID is used by both the Auth API and the static WebUI build.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
